local AnimCards = {}

local function updateAnimationCards()
    local query = string.lower(AnimSearch.Text or "")

    for name,card in pairs(AnimCards) do
        local show = query == "" or string.find(string.lower(name),query,1,true)

        card.Visible = show

        local active = CurrentPack == name

        if active then
            card.BackgroundColor3 = Color3.fromRGB(15,45,35)
            card.Status.Text = "● ACTIVE"
            card.Status.TextColor3 = GREEN
            card.Apply.Text = "ON"
            card.Apply.TextColor3 = GREEN
        else
            card.BackgroundColor3 = CARD
            card.Status.Text = "○ READY"
            card.Status.TextColor3 = GRAY
            card.Apply.Text = "APPLY"
            card.Apply.TextColor3 = CYAN
        end
