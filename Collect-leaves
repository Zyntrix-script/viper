--============================================================--
-- ANIMATION FUNCTIONS
--============================================================--

local CurrentPack = getgenv().ZYNTRIX_CurrentPack or nil

local function getAnimate(character)
    if not character then return nil end

    local animate = character:FindFirstChild("Animate")

    if animate then
        return animate
    end

    local deadline = os.clock() + 8

    repeat
        animate = character:FindFirstChild("Animate")

        if animate then
            return animate
        end

        task.wait(.1)
    until os.clock() >= deadline

    return nil
end

local function setAnimationObject(folder, animationName, id)
    if not folder or not id then return end

    local anim = folder:FindFirstChild(animationName)

    if not anim then
        anim = Instance.new("Animation")
        anim.Name = animationName
        anim.Parent = folder
    end

    anim.AnimationId = "rbxassetid://"..tostring(id)
end

local function applyFolder(animate, folderName, id, names)
    if not id then return end

    local folder = animate:FindFirstChild(folderName)

    if not folder then
        folder = Instance.new("Folder")
        folder.Name = folderName
        folder.Parent = animate
    end

    for _,name in ipairs(names) do
        setAnimationObject(folder,name,id)
    end
end

local function stopAnimations(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        pcall(function()
            for _,track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                track:Stop(.05)
            end
        end)
    end
end

local function applyPack(name)
    local data = PACKS[name]
    if not data then return false end

    local character = LP.Character
    if not character then return false end

    local animate = getAnimate(character)
    if not animate then return false end

    stopAnimations(character)

    applyFolder(animate,"walk",data.Walk,{"WalkAnim"})
    applyFolder(animate,"run",data.Run,{"RunAnim"})
    applyFolder(animate,"jump",data.Jump,{"JumpAnim"})
    applyFolder(animate,"fall",data.Fall,{"FallAnim"})
    applyFolder(animate,"climb",data.Climb,{"ClimbAnim"})
    applyFolder(animate,"swim",data.Swim,{"Swim"})
    applyFolder(animate,"swimidle",data.SwimIdle,{"SwimIdle"})

    local idle = animate:FindFirstChild("idle")

    if not idle then
        idle = Instance.new("Folder")
        idle.Name = "idle"
        idle.Parent = animate
    end

    local idle1 = data.Idle1
    local idle2 = data.Idle2 or data.Idle1

    if idle1 then
        setAnimationObject(idle,"Animation1",idle1)
    end

    if idle2 then
        setAnimationObject(idle,"Animation2",idle2)
    end

    CurrentPack = name
    getgenv().ZYNTRIX_CurrentPack = name

    pcall(function()
        animate.Disabled = true
        task.wait(.05)
        animate.Disabled = false
    end)

    return true
end

