local CatalogPage = 1
local CatalogSearchRunning = false

local function searchCatalog()
    if CatalogSearchRunning then return end

    CatalogSearchRunning = true

    clearEmoteList()

    local query = EmoteSearch.Text

    if query == "" then
        query = "dance"
    end

    local ok,result = pcall(function()
        local params = CatalogSearchParams.new()

        params.SearchKeyword = query
        params.AssetTypes = {
            Enum.AvatarAssetType.EmoteAnimation
        }

        params.SortType = Enum.CatalogSortType.Relevance
        params.IncludeOffSale = true
        params.Limit = 30

        return AvatarEditorService:SearchCatalog(params)
    end)

    if ok and result then
        local page = result

        local success = pcall(function()
            local current = page:GetCurrentPage()

            for _,item in ipairs(current) do
                createEmoteCard({
                    Id = item.Id,
                    Name = item.Name
                })
            end
        end)

        if not success then
            local fallback = {
                {
                    Id = 115314801778772,
                    Name = "Dance If Youre The Best"
                }
            }

            for _,item in ipairs(fallback) do
                createEmoteCard(item)
            end
        end
    else
        -- R6 / executor fallback
        createEmoteCard({
            Id = 115314801778772,
            Name = "Dance If Youre The Best"
        })
    end

    CatalogSearchRunning = false
end

