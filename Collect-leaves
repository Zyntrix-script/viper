local function New(class, props, parent)
    local obj = Instance.new(class)

    for k,v in pairs(props or {}) do
        pcall(function()
            obj[k] = v
        end)
    end

    if parent then
        obj.Parent = parent
    end

    return obj
end

local function Corner(obj, radius)
    New("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, obj)
end

local function Stroke(obj, color, thickness, transparency)
    return New("UIStroke", {
        Color = color or PURPLE,
        Thickness = thickness or 1,
        Transparency = transparency or 0
    }, obj)
end

local function Tween(obj, time, props)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props
    )
    t:Play()
    return t
end

local function SafeSet(obj, property, value)
    pcall(function()
        obj[property] = value
    end)
end

local function SetText(obj, text)
    if obj and obj:IsA("TextLabel") or obj and obj:IsA("TextButton") or obj and obj:IsA("TextBox") then
        obj.Text = tostring(text)
    end
end

local function CopyText(text)
    pcall(function()
        if setclipboard then
            setclipboard(tostring(text))
        elseif toclipboard then
            toclipboard(tostring(text))
        elseif Clipboard then
            Clipboard(tostring(text))
        end
    end)
end

