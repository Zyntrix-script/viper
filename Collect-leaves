--==============================================================--
-- DRAG SYSTEM
--==============================================================--

local function MakeDraggable(object, handle)

    local dragging = false
    local dragStart
    local startPos

    Connect(handle.InputBegan, function(input)

        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPos = object.Position

            local connection

            connection = input.Changed:Connect(function()

                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false

                    if connection then
                        connection:Disconnect()
                    end
                end

            end)

        end

    end)

    Connect(UserInputService.InputChanged, function(input)

        if not dragging then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart

        object.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )

    end)
end

MakeDraggable(Main, Top)
MakeDraggable(MenuButton, MenuButton)

--==============================================================--
-- ANIMATION APPLY SYSTEM
--==============================================================--

local CurrentPackName = nil
local ApplyToken = 0

local function GetCharacter()
    return Player.Character
end

local function GetAnimate()
    local Character = GetCharacter()

    if not Character then
        return nil
    end

    local Animate = Character:FindFirstChild("Animate")

    if not Animate then
        Animate = Character:WaitForChild("Animate", 5)
    end

    return Animate
end

local function EnsureAnimation(parent, name)

    local object = parent:FindFirstChild(name)

    if not object then
        object = Instance.new("Animation")
        object.Name = name
        object.Parent = parent
    end

    return object
end

local function SetAnimation(parent, name, id)

    if not id then
        return
    end

    local animation = EnsureAnimation(parent, name)

    pcall(function()
        animation.AnimationId = "rbxassetid://" .. tostring(id)
    end)
end

local function ApplyPack(packName)

    local pack = AnimationPacks[packName]

    if not pack then
        return
    end

    CurrentPackName = packName
    ApplyToken += 1

    local myToken = ApplyToken

    Status.Text =
        "ĐANG ÁP DỤNG: " .. packName .. " "

    task.spawn(function()

        local retryTimes = {
            0,
            0.15,
            0.35,
            0.7,
            1.2,
            2,
            3
        }

        for _, delayTime in ipairs(retryTimes) do

            if myToken ~= ApplyToken or not Alive then
                return
            end

            if delayTime > 0 then
                task.wait(delayTime)
            end

            local Animate = GetAnimate()

            if Animate then

                pcall(function()

                    local walk =
                        Animate:FindFirstChild("walk")

                    if walk then
                        SetAnimation(
                            walk,
                            "WalkAnim",
                            pack.Walk
                        )
                    end

                    local run =
                        Animate:FindFirstChild("run")

                    if run then
                        SetAnimation(
                            run,
                            "RunAnim",
                            pack.Run
                        )
                    end

                    local jump =
                        Animate:FindFirstChild("jump")

                    if jump then
                        SetAnimation(
                            jump,
                            "JumpAnim",
                            pack.Jump
                        )
                    end

                    local fall =
                        Animate:FindFirstChild("fall")

                    if fall then
                        SetAnimation(
                            fall,
                            "FallAnim",
                            pack.Fall
                        )
                    end

                    local climb =
                        Animate:FindFirstChild("climb")

                    if climb then
                        SetAnimation(
                            climb,
                            "ClimbAnim",
                            pack.Climb
                        )
                    end

                    local swim =
                        Animate:FindFirstChild("swim")

                    if swim then
                        SetAnimation(
                            swim,
                            "Swim",
                            pack.Swim
                        )
                    end

                    local swimIdle =
                        Animate:FindFirstChild("swimidle")

                    if swimIdle then
                        SetAnimation(
                            swimIdle,
                            "SwimIdle",
                            pack.SwimIdle
                        )
                    end

                    local idle =
                        Animate:FindFirstChild("idle")

                    if idle then

                        if pack.Idle1 then
                            SetAnimation(
                                idle,
                                "Animation1",
                                pack.Idle1
                            )
                        end

                        if pack.Idle2 then
                            SetAnimation(
                                idle,
                                "Animation2",
                                pack.Idle2
                            )
                        end

                    end

                end)

                Status.Text =
                    "ACTIVE • " .. packName .. " "

                return
            end

        end

        Status.Text =
            "CHƯA ÁP DỤNG ĐƯỢC • THỬ LẠI "

    end)
end

