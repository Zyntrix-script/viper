local function stopEmote()
    if CurrentEmoteTrack then
        pcall(function()
            CurrentEmoteTrack:Stop(.1)
            CurrentEmoteTrack:Destroy()
        end)
        CurrentEmoteTrack = nil
    end
end

local function getHumanoid()
    local char = LP.Character
    if not char then return nil end

    return char:FindFirstChildOfClass("Humanoid")
end

local function PlayEmote(id)
    id = tostring(id):gsub("rbxassetid://",""):gsub("%s+","")

    if id == "" then return false end

    local humanoid = getHumanoid()

    if not humanoid then return false end

    stopEmote()

    if EmoteSettings.StopOther then
        pcall(function()
            for _,track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                track:Stop(.1)
            end
        end)
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://"..id

    local ok,track = pcall(function()
        return humanoid:LoadAnimation(anim)
    end)

    if not ok or not track then
        anim:Destroy()
        return false
    end

    CurrentEmoteTrack = track

    pcall(function()
        if EmoteSettings.HighPriority then
            track.Priority = Enum.AnimationPriority.Action4
        else
            track.Priority = Enum.AnimationPriority.Action
        end

        track.Looped = EmoteSettings.Looped
        track:Play(.1,EmoteSettings.Weight,EmoteSettings.Speed)

        if EmoteSettings.TimePosition > 0 then
            track.TimePosition = EmoteSettings.TimePosition
        end
    end)

    anim.Parent = track

    return true
end

