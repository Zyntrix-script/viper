local PackCards = {}

local function ClearContent()
    for _, child in ipairs(Content:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end

    PackCards = {}
end

local function CreatePackCard(packName)

    local card = Instance.new("TextButton")
    card.Name = packName
    card.Size = UDim2.new(1, -4, 0, 52)
    card.AutoButtonColor = false
    card.Text = ""
    card.BackgroundColor3 = Color3.fromRGB(13, 16, 32)
    card.BackgroundTransparency = 0.10
    card.BorderSizePixel = 0
    card.Parent = Content

    Corner(card, 11)

    local border =
        Stroke(
            card,
            Color3.fromRGB(40, 100, 155),
            1,
            0.3
        )

    local title = MakeText(
        card,
        packName .. " ",
        13,
        true
    )

    title.Position = UDim2.new(0, 12, 0, 7)
    title.Size = UDim2.new(1, -24, 0, 20)

    local sub = MakeText(
        card,
        "ANIMATION PACK • CLICK TO APPLY ",
        9,
        false
    )

    sub.Position = UDim2.new(0, 12, 0, 29)
    sub.Size = UDim2.new(1, -24, 0, 15)
    sub.TextColor3 = Color3.fromRGB(125, 155, 180)

    Connect(card.MouseEnter, function()
        TweenService:Create(
            card,
            TweenInfo.new(
                0.25,
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundColor3 =
                    Color3.fromRGB(18, 25, 48)
            }
        ):Play()

        border.Color = Cyan
        border.Transparency = 0.05
    end)

    Connect(card.MouseLeave, function()
        TweenService:Create(
            card,
            TweenInfo.new(
                0.3,
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundColor3 =
                    Color3.fromRGB(13, 16, 32)
            }
        ):Play()

        border.Transparency = 0.3
    end)

    Connect(card.Activated, function()
        ApplyPack(packName)
    end)

    table.insert(PackCards, {
        Button = card,
        Name = packName
    })

    return card
end

local function RenderPacks(filter)

    ClearContent()

    local query =
        string.lower(
            tostring(filter or "")
        )

    for packName in pairs(AnimationPacks) do

        if query == ""
        or string.find(
            string.lower(packName),
            query,
            1,
            true
        ) then

            CreatePackCard(packName)

        end
    end

    task.defer(function()

        if ContentLayout then

            Content.CanvasSize =
                UDim2.new(
                    0,
                    0,
                    0,
                    ContentLayout.AbsoluteContentSize.Y + 20
                )

        end

    end)
end

